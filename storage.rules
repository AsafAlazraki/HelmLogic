rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read on all files.
    match /{allPaths=**} {
      allow read;
    }

    // Allow authenticated users to write to any path.
    // App logic and UI should control what paths they can write to.
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}

    