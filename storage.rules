rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access on all files so anyone can see org logos.
    match /{allPaths=**} {
      allow read;
    }

    // THIS IS A TEMPORARY AND INSECURE RULE FOR DIAGNOSTICS.
    // It allows any user, even unauthenticated ones, to write to the logos folder.
    match /organisations/{organisationId}/logos/{imageName} {
      allow write: if true;
    }
  }
}
