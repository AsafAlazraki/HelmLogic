{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "appRole": {
          "type": "string",
          "description": "The user's role within the application."
        },
        "organisationId": {
          "type": "string",
          "description": "The ID of the organisation the user belongs to."
        },
        "organisationRole": {
          "type": "string",
          "description": "The ID of the user's role within their organisation."
        }
      },
      "required": [
        "email"
      ]
    },
    "Organisation": {
      "title": "Organisation",
      "description": "Represents an organisation within the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the organisation."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the organisation name."
        },
        "address": {
          "type": "string",
          "description": "The physical address of the organisation."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The contact phone number for the organisation."
        },
        "abn": {
          "type": "string",
          "description": "The Australian Business Number for the organisation."
        },
        "primaryColor": {
          "type": "string",
          "description": "The primary branding color in hex format."
        },
        "accentColor": {
          "type": "string",
          "description": "The accent branding color in hex format."
        },
        "secondaryColor": {
          "type": "string",
          "description": "The secondary branding color in hex format."
        },
        "primaryLogoUrl": {
          "type": "string",
          "description": "URL for the primary company logo."
        },
        "secondaryLogoUrl": {
          "type": "string",
          "description": "URL for the secondary company logo or icon."
        },
        "subDealersEnabled": {
          "type": "boolean",
          "description": "Indicates if the Sub Dealers module is enabled for the organisation."
        },
        "parentOrganisationId": {
          "type": "string",
          "description": "The ID of the parent organisation, if this is a sub-dealer."
        },
        "roles": {
          "type": "array",
          "description": "A list of roles within the organisation, forming a hierarchy.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "A unique identifier for the role."
              },
              "name": {
                "type": "string",
                "description": "The name of the role."
              },
              "parent": {
                "type": "string",
                "description": "The ID of the parent role. Empty for top-level roles."
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "permissions": {
          "type": "object",
          "description": "Defines permissions for each role ID.",
          "additionalProperties": {
            "type": "object",
            "description": "A map of permission keys to boolean values.",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "dataWarehouseSubscriptions": {
          "type": "array",
          "description": "A list of vendor IDs from the data warehouse that this organisation is subscribed to.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "slug"
      ]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Represents a vendor for data connection.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the vendor."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the vendor name."
        },
        "vendorType": {
          "type": "string",
          "description": "The type of the vendor.",
          "enum": [
            "Boat Brand",
            "Motor Brand",
            "Trailer Brand",
            "Electronics Brand",
            "Electronics Supplier",
            "Parts Wholesaler",
            "Other"
          ]
        },
        "dataSource": {
          "type": "string",
          "description": "The source of the data connection.",
          "enum": [
            "Business Central",
            "Direct API",
            "Document Upload",
            "Other"
          ]
        },
        "primaryContact": {
          "type": "string",
          "description": "Primary contact for the vendor (e.g., name, email, phone)."
        },
        "website": {
          "type": "string",
          "description": "The vendor's website URL."
        },
        "address": {
          "type": "string",
          "description": "The physical address of the vendor."
        },
        "abn": {
          "type": "string",
          "description": "The Australian Business Number for the vendor."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL for the vendor logo."
        },
        "notes": {
          "type": "string",
          "description": "General notes about the vendor."
        },
        "attachmentName": {
          "type": "string",
          "description": "The name of the uploaded file attachment."
        },
        "attachmentUrl": {
          "type": "string",
          "description": "The data URI of the uploaded file attachment."
        }
      },
      "required": [
        "name",
        "slug"
      ]
    },
    "Range": {
      "title": "Range",
      "description": "Represents a product range for a vendor.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the range."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the range name."
        },
        "vendorId": {
          "type": "string",
          "description": "The ID of the vendor this range belongs to."
        }
      },
      "required": [
        "name",
        "slug",
        "vendorId"
      ]
    },
    "Model": {
      "title": "Model",
      "description": "Represents a specific model within a product range.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the model."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the model name."
        },
        "rangeId": {
          "type": "string",
          "description": "The ID of the range this model belongs to."
        },
        "vendorId": {
          "type": "string",
          "description": "The ID of the vendor this model belongs to."
        },
        "coverImageUrl": {
          "type": "string",
          "description": "URL for the boat's main cover image."
        },
        "cost": {
          "type": "number",
          "description": "Base cost of the model."
        },
        "sellPriceExclGst": {
            "type": "number",
            "description": "Base selling price, excluding GST."
        },
        "freightCostExclGst": {
            "type": "number",
            "description": "Freight cost, excluding GST."
        },
        "colors": {
          "type": "array",
          "description": "Available color variants for the model, each with associated images.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "imageUrls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "standardFeatures": {
          "type": "array",
          "description": "A list of standard features for the model.",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "description": "A list of optional packages for the model.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "imageUrl": {
                "type": "string"
              },
              "cost": {
                "type": "number"
              },
              "sellPriceExclGst": {
                "type": "number"
              },
              "freightCostExclGst": {
                "type": "number"
              },
              "includedFeatures": {
                "type": "array",
                "description": "A list of features included in this package.",
                "items": {
                  "type": "string"
                }
              },
              "optionalFeatures": {
                "type": "array",
                "description": "A list of optional add-ons within this package.",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "cost": {
                      "type": "number"
                    },
                    "sellPriceExclGst": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "specifications": {
          "type": "object",
          "properties": {
            "minHp": {
              "type": "number"
            },
            "maxHp": {
              "type": "number"
            },
            "recommendedHp": {
              "type": "number"
            },
            "otherSpecs": {
              "type": "array",
              "description": "A list of other key-value specifications.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "value"
                ]
              }
            }
          },
          "required": [
            "minHp",
            "maxHp",
            "recommendedHp"
          ]
        }
      },
      "required": [
        "name",
        "slug",
        "rangeId",
        "vendorId"
      ]
    }
  },
  "auth": {
    "providers": [
      "email"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "User profile documents, keyed by user ID."
    },
    "/organisations/{organisationId}": {
      "schema": {
        "$ref": "#/backend/entities/Organisation"
      },
      "description": "Organisation documents, keyed by a unique ID."
    },
    "/data-warehouse/{vendorId}": {
      "schema": {
        "$ref": "#/backend/entities/Vendor"
      },
      "description": "Vendor documents for the data warehouse, keyed by a unique ID."
    },
    "/data-warehouse/{vendorId}/ranges/{rangeId}": {
      "schema": {
        "$ref": "#/backend/entities/Range"
      },
      "description": "Product ranges for a specific vendor."
    },
    "/data-warehouse/{vendorId}/ranges/{rangeId}/models/{modelId}": {
      "schema": {
        "$ref": "#/backend/entities/Model"
      },
      "description": "Specific models within a product range."
    }
  }
}
