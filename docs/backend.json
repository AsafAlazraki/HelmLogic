
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "appRole": {
          "type": "string",
          "description": "The user's role within the application."
        },
        "organisationId": {
          "type": "string",
          "description": "The ID of the organisation the user belongs to."
        },
        "organisationRole": {
          "type": "string",
          "description": "The ID of the user's role within their organisation."
        }
      },
      "required": [
        "email"
      ]
    },
    "Organisation": {
      "title": "Organisation",
      "description": "Represents an organisation within the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the organisation."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the organisation name."
        },
        "address": {
          "type": "string",
          "description": "The physical address of the organisation."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The contact phone number for the organisation."
        },
        "abn": {
          "type": "string",
          "description": "The Australian Business Number for the organisation."
        },
        "primaryColor": {
          "type": "string",
          "description": "The primary branding color in hex format."
        },
        "accentColor": {
          "type": "string",
          "description": "The accent branding color in hex format."
        },
        "secondaryColor": {
          "type": "string",
          "description": "The secondary branding color in hex format."
        },
        "primaryLogoUrl": {
          "type": "string",
          "description": "URL for the primary company logo."
        },
        "secondaryLogoUrl": {
          "type": "string",
          "description": "URL for the secondary company logo or icon."
        },
        "subDealersEnabled": {
          "type": "boolean",
          "description": "Indicates if the Sub Dealers module is enabled for the organisation."
        },
        "parentOrganisationId": {
          "type": "string",
          "description": "The ID of the parent organisation, if this is a sub-dealer."
        },
        "roles": {
          "type": "array",
          "description": "A list of roles within the organisation, forming a hierarchy.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "A unique identifier for the role."
              },
              "name": {
                "type": "string",
                "description": "The name of the role."
              },
              "parent": {
                "type": "string",
                "description": "The ID of the parent role. Empty for top-level roles."
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "permissions": {
          "type": "object",
          "description": "Defines permissions for each role ID.",
          "additionalProperties": {
            "type": "object",
            "description": "A map of permission keys to boolean values.",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "dataWarehouseSubscriptions": {
          "type": "array",
          "description": "A list of vendor IDs from the data warehouse that this organisation is subscribed to.",
          "items": {
            "type": "string"
          }
        },
        "enabledModuleSubscriptions": {
          "type": "array",
          "description": "A list of module IDs that this organisation has access to.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "slug"
      ]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Represents a vendor for data connection.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the vendor."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the vendor name."
        },
        "vendorType": {
          "type": "string",
          "description": "The type of the vendor.",
          "enum": [
            "Boat Brand",
            "Motor Brand",
            "Trailer Brand",
            "Electronics Brand",
            "Electronics Supplier",
            "Parts Wholesaler",
            "Other"
          ]
        },
        "dataSource": {
          "type": "string",
          "description": "The source of the data connection.",
          "enum": [
            "Business Central",
            "Direct API",
            "Document Upload",
            "Other"
          ]
        },
        "primaryContact": {
          "type": "string",
          "description": "Primary contact for the vendor (e.g., name, email, phone)."
        },
        "website": {
          "type": "string",
          "description": "The vendor's website URL."
        },
        "address": {
          "type": "string",
          "description": "The physical address of the vendor."
        },
        "abn": {
          "type": "string",
          "description": "The Australian Business Number for the vendor."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL for the vendor logo."
        },
        "notes": {
          "type": "string",
          "description": "General notes about the vendor."
        }
      },
      "required": [
        "name",
        "slug"
      ]
    },
    "Vessel": {
      "title": "Vessel",
      "description": "Represents a maritime vessel managed within the application, including its status and ownership.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "serialNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["On Order", "In Stock", "Reserved", "Sold", "In Transit"] },
        "organisationId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "serialNumber", "status", "organisationId"]
    },
    "VesselReservation": {
      "title": "Vessel Reservation",
      "description": "Represents a request by a sub-dealer to reserve an 'on order' vessel for a customer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vesselId": { "type": "string" },
        "subDealerOrganisationId": { "type": "string" },
        "vesselOwnerOrganisationId": { "type": "string" },
        "requestedByUserId": { "type": "string" },
        "customerName": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Awaiting Confirmation", "Approved", "Declined", "Cancelled"] },
        "requestedAt": { "type": "string", "format": "date-time" },
        "processedByUserId": { "type": "string" },
        "processedAt": { "type": "string", "format": "date-time" },
        "declineNote": { "type": "string" }
      },
      "required": ["id", "vesselId", "subDealerOrganisationId", "vesselOwnerOrganisationId", "requestedByUserId", "customerName", "status", "requestedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Represents a notification sent to a user within the application.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientUserId": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "sourceEntityId": { "type": "string" },
        "sourceEntityType": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientUserId", "type", "message", "isRead", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "email"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "User profile documents, keyed by user ID."
    },
    "/organisations/{organisationId}": {
      "schema": {
        "$ref": "#/backend/entities/Organisation"
      },
      "description": "Organisation documents, keyed by a unique ID."
    },
    "/data-warehouse/{vendorId}": {
      "schema": {
        "$ref": "#/backend/entities/Vendor"
      },
      "description": "Vendor documents for the data warehouse, keyed by a unique ID."
    },
    "/data-warehouse/{vendorId}/masterDataSet/{rowId}": {
      "schema": {
        "$ref": "#/backend/entities/MasterDataRow"
      },
      "description": "A collection of individual data rows that make up the vendor's master data set."
    },
    "/vessels/{vesselId}": {
      "schema": {
        "$ref": "#/backend/entities/Vessel"
      },
      "description": "Managed maritime vessels."
    },
    "/vesselReservations/{reservationId}": {
      "schema": {
        "$ref": "#/backend/entities/VesselReservation"
      },
      "description": "Vessel reservation requests from sub-dealers."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/backend/entities/Notification"
      },
      "description": "User-specific notifications."
    }
  }
}
