{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "appRole": { "type": "string" },
        "organisationId": { "type": "string" },
        "organisationRole": { "type": "string" },
        "moduleOrder": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["email"]
    },
    "Organisation": {
      "title": "Organisation",
      "description": "Represents an organisation within the application.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "address": { "type": "string" },
        "tradingCurrency": { "type": "string" },
        "gstPercentage": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Module": {
      "title": "Module",
      "description": "An application functional module.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mainVendorId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["email", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "User profile data."
    },
    "/modules/{moduleId}": {
      "schema": { "$ref": "#/backend/entities/Module" },
      "description": "Available application modules."
    },
    "/organisations/{organisationId}": {
      "schema": { "$ref": "#/backend/entities/Organisation" },
      "description": "Company and dealer details."
    },
    "/data-warehouse/{vendorId}": {
      "schema": { "type": "object" },
      "description": "Master data for vendors and catalogs."
    },
    "/inventory/{itemId}": {
      "schema": { "type": "object" },
      "description": "Stock units."
    }
  }
}