{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "appRole": {
          "type": "string",
          "description": "The user's role within the application."
        },
        "organisationId": {
          "type": "string",
          "description": "The ID of the organisation the user belongs to."
        },
        "organisationRole": {
          "type": "string",
          "description": "The ID of the user's role within their organisation."
        }
      },
      "required": [
        "email"
      ]
    },
    "Organisation": {
      "title": "Organisation",
      "description": "Represents an organisation within the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the organisation."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the organisation name."
        },
        "address": {
          "type": "string",
          "description": "The physical address of the organisation."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The contact phone number for the organisation."
        },
        "abn": {
          "type": "string",
          "description": "The Australian Business Number for the organisation."
        },
        "primaryColor": {
          "type": "string",
          "description": "The primary branding color in hex format."
        },
        "accentColor": {
          "type": "string",
          "description": "The accent branding color in hex format."
        },
        "secondaryColor": {
          "type": "string",
          "description": "The secondary branding color in hex format."
        },
        "primaryLogoUrl": {
          "type": "string",
          "description": "URL for the primary company logo."
        },
        "secondaryLogoUrl": {
          "type": "string",
          "description": "URL for the secondary company logo or icon."
        },
        "subDealersEnabled": {
          "type": "boolean",
          "description": "Indicates if the Sub Dealers module is enabled for the organisation."
        },
        "parentOrganisationId": {
          "type": "string",
          "description": "The ID of the parent organisation, if this is a sub-dealer."
        },
        "tradingCurrency": {
          "type": "string",
          "description": "The currency the organisation trades in.",
          "default": "AUD"
        },
        "gstPercentage": {
          "type": "number",
          "description": "The GST percentage for the organisation's region.",
          "default": 10
        },
        "brandMargins": {
          "type": "object",
          "description": "Required margin per subscribed brand (vendorId -> margin percentage).",
          "additionalProperties": {
            "type": "number"
          }
        },
        "rangeMargins": {
          "type": "object",
          "description": "Required margin per range (rangeId -> margin percentage).",
          "additionalProperties": {
            "type": "number"
          }
        },
        "modelMargins": {
          "type": "object",
          "description": "Required margin per model (modelId -> margin percentage).",
          "additionalProperties": {
            "type": "number"
          }
        },
        "moduleMargins": {
          "type": "object",
          "description": "Price margins within specific modules (moduleId -> margin percentage).",
          "additionalProperties": {
            "type": "number"
          }
        },
        "roles": {
          "type": "array",
          "description": "A list of roles within the organisation, forming a hierarchy.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "A unique identifier for the role."
              },
              "name": {
                "type": "string",
                "description": "The name of the role."
              },
              "parent": {
                "type": "string",
                "description": "The ID of the parent role. Empty for top-level roles."
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "permissions": {
          "type": "object",
          "description": "Defines permissions for each role ID.",
          "additionalProperties": {
            "type": "object",
            "description": "A map of permission keys to boolean values.",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "dataWarehouseSubscriptions": {
          "type": "array",
          "description": "A list of vendor IDs from the data warehouse that this organisation is subscribed to.",
          "items": {
            "type": "string"
          }
        },
        "enabledModuleSubscriptions": {
          "type": "array",
          "description": "A list of module IDs that this organisation has access to.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "slug"
      ]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Represents a vendor for data connection.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the vendor."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the vendor name."
        },
        "currency": {
          "type": "string",
          "description": "The currency of the information stored in the master data set.",
          "default": "AUD"
        },
        "vendorType": {
          "type": "string",
          "description": "The type of the vendor.",
          "enum": [
            "Boat Brand",
            "Motor Brand",
            "Trailer Brand",
            "Electronics Brand",
            "Electronics Supplier",
            "Parts Wholesaler",
            "Other"
          ]
        },
        "dataSource": {
          "type": "string",
          "description": "The source of the data connection.",
          "enum": [
            "Business Central",
            "Direct API",
            "Document Upload",
            "Other"
          ]
        },
        "primaryContact": {
          "type": "string",
          "description": "Primary contact for the vendor (e.g., name, email, phone)."
        },
        "website": {
          "type": "string",
          "description": "The vendor's website URL."
        },
        "address": {
          "type": "string",
          "description": "The physical address of the vendor."
        },
        "abn": {
          "type": "string",
          "description": "The Australian Business Number for the vendor."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL for the vendor logo."
        },
        "notes": {
          "type": "string",
          "description": "General notes about the vendor."
        }
      },
      "required": [
        "name",
        "slug"
      ]
    },
    "MasterDataRow": {
      "title": "Master Data Row",
      "description": "Represents a single row of data from a vendor's master data set.",
      "type": "object",
      "additionalProperties": true
    },
    "Range": {
      "title": "Range",
      "description": "Represents a product range for a vendor.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the range."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the range name."
        },
        "vendorId": {
          "type": "string",
          "description": "The ID of the vendor this range belongs to."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL for the range's image."
        },
        "order": {
          "type": "number",
          "description": "The display order of the range."
        }
      },
      "required": [
        "name",
        "slug",
        "vendorId"
      ]
    },
    "Model": {
      "title": "Model",
      "description": "Represents a specific model within a product range.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the model."
        },
        "modelCode": {
          "type": "string",
          "description": "A unique identifier or code for the model."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the model name."
        },
        "rangeId": {
          "type": "string",
          "description": "The ID of the range this model belongs to."
        },
        "vendorId": {
          "type": "string",
          "description": "The ID of the vendor this model belongs to."
        },
        "order": {
          "type": "number",
          "description": "The display order of the model."
        },
        "coverImageUrl": {
          "type": "string",
          "description": "URL for the boat's main cover image."
        },
        "galleryImageUrls": {
          "type": "array",
          "description": "A list of URLs for the model's image gallery.",
          "items": {
            "type": "string"
          }
        },
        "cost": {
          "type": "number",
          "description": "Base cost of the model."
        },
        "sellPriceExclGst": {
          "type": "number",
          "description": "Base selling price, excluding GST."
        },
        "freightCostExclGst": {
          "type": "number",
          "description": "Freight cost, excluding GST."
        },
        "colors": {
          "type": "array",
          "description": "Available color variants for the model, each with associated images.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "imageUrls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "standardFeatures": {
          "type": "array",
          "description": "A list of standard features for the model.",
          "items": {
            "type": "string"
          }
        },
        "optionalFeatures": {
          "type": "array",
          "description": "A list of optional add-ons for the model.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "description": "The category for the optional feature."
              },
              "imageUrl": {
                "type": "string"
              },
              "packageStatus": {
                "type": "object",
                "description": "A map of package IDs to their status ('standard' or 'optional') for this feature.",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "standard",
                    "optional"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "packages": {
          "type": "array",
          "description": "A list of optional packages for the model.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "description": "The category for the optional package."
              },
              "imageUrl": {
                "type": "string"
              },
              "cost": {
                "type": "number"
              },
              "sellPriceExclGst": {
                "type": "number"
              },
              "includedFeatures": {
                "type": "array",
                "description": "A list of features included in this package.",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "packageLevels": {
          "type": "array",
          "description": "A list of tiered packages for a Stabicraft model.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "A description for the package level."
              },
              "cost": {
                "type": "number"
              },
              "sellPriceExclGst": {
                "type": "number"
              },
              "includedFeatures": {
                "type": "array",
                "description": "A list of features included in this package level.",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "uDekOptions": {
          "type": "object",
          "description": "U-Dek flooring image URLs.",
          "properties": {
            "blackOnWinterGrey": {
              "type": "string"
            },
            "teakOnBlack": {
              "type": "string"
            },
            "steelGreyOnWinterGrey": {
              "type": "string"
            },
            "winterGreyOnSteelGrey": {
              "type": "string"
            }
          }
        },
        "paintAndGraphicOptions": {
          "type": "object",
          "description": "Paint and graphic options for a Stabicraft model.",
          "properties": {
            "standardGloss": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "imageUrl": {
                    "type": "string"
                  },
                  "paint": {
                    "type": "string"
                  },
                  "graphics": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "standardMetallic": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "imageUrl": {
                    "type": "string"
                  },
                  "paint": {
                    "type": "string"
                  },
                  "graphics": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "powderCoating": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "imageUrl": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "specifications": {
          "type": "object",
          "properties": {
            "motorConfigurations": {
              "type": "array",
              "description": "Defines the supported engine configurations and their respective horsepower ratings.",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "Single",
                      "Twin",
                      "Triple",
                      "Quad",
                      "SingleWithAux"
                    ]
                  },
                  "engines": {
                    "type": "array",
                    "description": "An array of engine specifications for this configuration.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "A label for the engine (e.g., 'Main Engine', 'Engine 1')."
                        },
                        "minHp": {
                          "type": "number"
                        },
                        "maxHp": {
                          "type": "number"
                        },
                        "recommendedHp": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "label"
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "engines"
                ]
              }
            },
            "otherSpecs": {
              "type": "array",
              "description": "A list of other key-value specifications.",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "value"
                ]
              }
            }
          }
        },
        "variantPricing": {
          "type": "array",
          "description": "Pricing for specific model variants (e.g., by color and material). Highfield specific.",
          "items": {
            "type": "object",
            "properties": {
              "colorId": {
                "type": "string"
              },
              "colorName": {
                "type": "string"
              },
              "material": {
                "type": "string",
                "enum": [
                  "HYP",
                  "PVC"
                ]
              },
              "cost": {
                "type": "number"
              },
              "sellPriceExclGst": {
                "type": "number"
              },
              "freightCostExclGst": {
                "type": "number"
              }
            },
            "required": [
              "colorId",
              "material"
            ]
          }
        },
        "documents": {
          "type": "array",
          "description": "A list of documents associated with the model.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ]
          }
        }
      },
      "required": [
        "name",
        "slug",
        "rangeId",
        "vendorId"
      ]
    },
    "Module": {
      "title": "Module",
      "description": "Represents an application module that connects various vendors and data for an organisation.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the module."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the module name."
        },
        "mainVendorId": {
          "type": "string",
          "description": "The ID of the main vendor for this module."
        },
        "associatedVendorIds": {
          "type": "array",
          "description": "A list of IDs for associated vendors.",
          "items": {
            "type": "string"
          }
        },
        "logoUrl": {
          "type": "string",
          "description": "URL for the module's logo, typically inherited from the main vendor."
        }
      },
      "required": [
        "name",
        "slug",
        "mainVendorId"
      ]
    }
  },
  "auth": {
    "providers": [
      "email"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "User profile documents, keyed by user ID."
    },
    "/organisations/{organisationId}": {
      "schema": {
        "$ref": "#/backend/entities/Organisation"
      },
      "description": "Organisation documents, keyed by a unique ID."
    },
    "/data-warehouse/{vendorId}": {
      "schema": {
        "$ref": "#/backend/entities/Vendor"
      },
      "description": "Vendor documents for the data warehouse, keyed by a unique ID."
    },
    "/data-warehouse/{vendorId}/masterDataSet/{rowId}": {
      "schema": {
        "$ref": "#/backend/entities/MasterDataRow"
      },
      "description": "A collection of individual data rows that make up the vendor's master data set."
    },
    "/data-warehouse/{vendorId}/ranges/{rangeId}": {
      "schema": {
        "$ref": "#/backend/entities/Range"
      },
      "description": "Product ranges for a specific vendor."
    },
    "/data-warehouse/{vendorId}/ranges/{rangeId}/models/{modelId}": {
      "schema": {
        "$ref": "#/backend/entities/Model"
      },
      "description": "Specific models within a product range."
    },
    "/data-warehouse/{vendorId}/masterPriceList/{rowId}": {
      "schema": {
        "$ref": "#/backend/entities/MasterDataRow"
      },
      "description": "A collection of individual data rows that make up the vendor's master price list."
    },
    "/data-warehouse/{vendorId}/bulkMasterPriceList/{rowId}": {
      "schema": {
        "$ref": "#/backend/entities/MasterDataRow"
      },
      "description": "A collection of individual data rows that make up the vendor's bulk master price list."
    },
    "/modules/{moduleId}": {
      "schema": {
        "$ref": "#/backend/entities/Module"
      },
      "description": "Application modules."
    }
  }
}
