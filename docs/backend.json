
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "appRole": {
          "type": "string",
          "description": "The user's role within the application."
        },
        "organisationId": {
          "type": "string",
          "description": "The ID of the organisation the user belongs to."
        },
        "organisationRole": {
          "type": "string",
          "description": "The ID of the user's role within their organisation."
        },
        "moduleOrder": {
          "type": "array",
          "description": "User-specific order of dashboard modules.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "email"
      ]
    },
    "Organisation": {
      "title": "Organisation",
      "description": "Represents an organisation within the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the organisation."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the organisation name."
        },
        "address": {
          "type": "string",
          "description": "The physical address of the organisation."
        },
        "phoneNumber": {
          "type": "string",
          "description": "The contact phone number for the organisation."
        },
        "abn": {
          "type": "string",
          "description": "The Australian Business Number for the organisation."
        },
        "primaryColor": {
          "type": "string",
          "description": "The primary branding color in hex format."
        },
        "accentColor": {
          "type": "string",
          "description": "The accent branding color in hex format."
        },
        "secondaryColor": {
          "type": "string",
          "description": "The secondary branding color in hex format."
        },
        "primaryLogoUrl": {
          "type": "string",
          "description": "URL for the primary company logo."
        },
        "secondaryLogoUrl": {
          "type": "string",
          "description": "URL for the secondary company logo or icon."
        },
        "subDealersEnabled": {
          "type": "boolean",
          "description": "Indicates if the Sub Dealers module is enabled for the organisation."
        },
        "parentOrganisationId": {
          "type": "string",
          "description": "The ID of the parent organisation, if this is a sub-dealer."
        },
        "tradingCurrency": {
          "type": "string",
          "description": "The primary currency used for local pricing."
        },
        "gstPercentage": {
          "type": "number",
          "description": "Applicable tax percentage."
        },
        "roles": {
          "type": "array",
          "description": "A list of roles within the organisation, forming a hierarchy.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "A unique identifier for the role."
              },
              "name": {
                "type": "string",
                "description": "The name of the role."
              },
              "parent": {
                "type": "string",
                "description": "The ID of the parent role. Empty for top-level roles."
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "permissions": {
          "type": "object",
          "description": "Defines permissions for each role ID.",
          "additionalProperties": {
            "type": "object",
            "description": "A map of permission keys to boolean values.",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "dataWarehouseSubscriptions": {
          "type": "array",
          "description": "A list of vendor IDs from the data warehouse that this organisation is subscribed to.",
          "items": {
            "type": "string"
          }
        },
        "enabledModuleSubscriptions": {
          "type": "array",
          "description": "A list of module IDs that this organisation has access to.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "slug"
      ]
    },
    "Template": {
      "title": "Template",
      "description": "User-defined document templates (Quote, Invoice, Contract).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Quote", "Invoice", "Contract"] },
        "moduleId": { "type": "string" },
        "createdByUserId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "moduleId", "createdByUserId"]
    },
    "DocumentTemplateContent": {
      "title": "DocumentTemplateContent",
      "description": "Stores the detailed layout JSON for a specific Template.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "templateId": { "type": "string" },
        "pages": { "type": "array" }
      },
      "required": ["id", "templateId", "pages"]
    },
    "ExchangeRate": {
      "title": "Exchange Rate",
      "description": "Organisation-specific manual exchange rate settings.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Currency code (e.g. USD)" },
        "rate": { "type": "number", "description": "Exchange rate relative to base currency." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "rate"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Represents a vendor for data connection.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the vendor."
        },
        "slug": {
          "type": "string",
          "description": "A URL-friendly version of the vendor name."
        },
        "vendorType": {
          "type": "string",
          "description": "The type of the vendor.",
          "enum": [
            "Boat Brand",
            "Motor Brand",
            "Trailer Brand",
            "Electronics Brand",
            "Electronics Supplier",
            "Parts Wholesaler",
            "Other"
          ]
        },
        "dataSource": {
          "type": "string",
          "description": "The source of the data connection.",
          "enum": [
            "Business Central",
            "Direct API",
            "Document Upload",
            "Other"
          ]
        }
      },
      "required": [
        "name",
        "slug"
      ]
    },
    "Range": {
      "title": "Range",
      "description": "Represents a product range for a vendor.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "vendorId": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "order": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "slug",
        "vendorId"
      ]
    },
    "Model": {
      "title": "Model",
      "description": "Represents a specific model within a product range.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "rangeId": {
          "type": "string"
        },
        "vendorId": {
          "type": "string"
        },
        "order": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "slug",
        "rangeId",
        "vendorId"
      ]
    }
  },
  "auth": {
    "providers": [
      "email"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "User profile documents."
    },
    "/users/{userId}/templates/{templateId}": {
      "schema": {
        "$ref": "#/backend/entities/Template"
      },
      "description": "User-specific document templates."
    },
    "/users/{userId}/templates/{templateId}/documentTemplateContent/document": {
      "schema": {
        "$ref": "#/backend/entities/DocumentTemplateContent"
      },
      "description": "The heavy content definition for a template."
    },
    "/organisations/{organisationId}": {
      "schema": {
        "$ref": "#/backend/entities/Organisation"
      },
      "description": "Organisation documents."
    },
    "/organisations/{organisationId}/exchangeRates/{currencyCode}": {
      "schema": {
        "$ref": "#/backend/entities/ExchangeRate"
      },
      "description": "Organisation-specific manual exchange rate settings."
    },
    "/data-warehouse/{vendorId}": {
      "schema": {
        "$ref": "#/backend/entities/Vendor"
      },
      "description": "Vendor documents."
    },
    "/data-warehouse/{vendorId}/ranges/{rangeId}": {
      "schema": {
        "$ref": "#/backend/entities/Range"
      },
      "description": "Product ranges."
    },
    "/data-warehouse/{vendorId}/ranges/{rangeId}/models/{modelId}": {
      "schema": {
        "$ref": "#/backend/entities/Model"
      },
      "description": "Specific boat models."
    }
  }
}
