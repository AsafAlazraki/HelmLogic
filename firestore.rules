rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules - Prototyping Phase
     * 
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model for personal data and a collaborative 
     * membership model for shared client records. Security is primarily path-based or driven 
     * by denormalized authorization fields within documents.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
      match /quotes/{quoteId} {
        allow read, write: if isOwner(userId);
        match /service_items/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }
      match /routes/{routeId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /organisations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /templates/{templateId} {
        allow read, write: if isSignedIn();
      }
      match /modelOverrides/{modelId} {
        allow read, write: if isSignedIn();
      }
      match /exchangeRates/{code} {
        allow read, write: if isSignedIn();
        match /changeLog/{logId} {
          allow read, write: if isSignedIn();
        }
      }
      match /pricingStrategies/{vendorId} {
        allow read, write: if isSignedIn();
      }
      match /dealerFitSelections/{selectionId} {
        allow read, write: if isSignedIn();
      }
    }

    match /data-warehouse/{vendorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /ranges/{rangeId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();

        match /models/{modelId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();

          match /variants/{variantId} {
            allow read: if isSignedIn();
            allow write: if isAdmin();
          }
        }
      }

      match /masterDataSet/{docId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /dataSets/{setId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();

        match /rows/{rowId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
        }
      }
    }

    match /dealerFitCategories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    // Legacy support for clients collection
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }

    // Legacy support for global models
    match /vessel_models/{vesselModelId} {
      allow read: if isSignedIn();
    }
  }
}