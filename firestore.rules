rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES
     * Core Philosophy: Standardized access for MVP development.
     */

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /notifications/{id} {
        allow read, write: if isOwner(userId);
      }
    }

    match /organisations/{orgId} {
      // Members can read their org. For MVP, we allow any signed-in user read access.
      allow read: if isSignedIn();
      allow write: if false; // System/Admin only
      
      match /dealerFitSelections/{id} { allow read, write: if isSignedIn(); }
      match /quotes/{id} { allow read, write: if isSignedIn(); }
      match /productPrices/{id} { allow read, write: if isSignedIn(); }
      match /priceLevelDefinitions/{id} { allow read, write: if isSignedIn(); }
      match /inventory/{id} { allow read, write: if isSignedIn(); }
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /data-warehouse/{vendorId} {
      allow read: if isSignedIn();
      allow write: if false;
      
      match /dataSets/{setId} {
        allow read: if isSignedIn();
        match /rows/{rowId} {
          allow read: if isSignedIn();
        }
      }
      match /masterDataSet/{rowId} {
        allow read: if isSignedIn();
      }
      match /ranges/{rangeId} {
        allow read: if isSignedIn();
        match /models/{modelId} {
          allow read: if isSignedIn();
          match /{allPaths=**} {
            allow read: if isSignedIn();
          }
        }
      }
    }

    match /dealerFitCategories/{id} {
      allow read: if isSignedIn();
    }
    
    match /inventory/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /vessels/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /vesselReservations/{id} {
      allow read, write: if isSignedIn();
    }
  }
}