rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules
     * 
     * Core Philosophy:
     * This ruleset implements a multi-tenant, hierarchical authorization model based on 
     * Organizations. Access is primarily determined by a user's affiliation with an 
     * Organization or their role as a Sub-Dealer to a Parent Organization.
     * 
     * Data Structure:
     * - /organizations: Top-level collection for all entity groups.
     * - /users: Source of truth for user profiles and organization context (DBAC).
     * - /vessels: Managed assets owned by parent organizations, viewable by sub-dealers.
     * - /vesselReservations: Shared collaboration documents between sub-dealers and parents.
     * - /users/{userId}/notifications: Private user-specific messaging.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(orgId) {
      return isSignedIn() && getUserData().organizationId == orgId;
    }

    function isSubDealerOf(orgId) {
      return isSignedIn() && getUserData().parentOrganizationId == orgId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /organizations/{organizationId} {
      allow get: if isMemberOf(organizationId) || isSubDealerOf(organizationId);
      allow list: if false; 
      allow create, update, delete: if isSignedIn(); // Simplified for prototyping
    }

    match /users/{userId} {
      allow get: if isSignedIn(); // Allow reading other users for notifications logic
      allow list: if isSignedIn(); // Allow discovery for prototype
      allow create: if isOwner(userId);
      allow update: if isSignedIn(); 
      allow delete: if false;
    }

    match /vessels/{vesselId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /vesselReservations/{reservationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow create: if isSignedIn(); // Allow creation by other users/system logic for prototype
      allow delete: if false;
    }
    
    // Inventory collection from previous turn
    match /inventory/{itemId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    // Modules collection
    match /modules/{moduleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    // Dealer Fit Categories
    match /dealerFitCategories/{catId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
