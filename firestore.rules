rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isHelmLogicAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'HelmLogic Admin';
    }

    function isMemberOfOrganisation(organisationId) {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == organisationId;
    }

    match /users/{userId} {
      // A user can create their own user document.
      allow create: if request.auth.uid == userId;

      // A user can read their own user document.
      allow read: if request.auth.uid == userId;

      // A user can update their own user document.
      allow update: if request.auth.uid == userId;

      // Deletes are not allowed.
      allow delete: if false;
    }

    match /organisations/{organisationId} {
      // Any authenticated user can read organisation data.
      // This allows non-admins to view organisation pages by slug.
      // Writes are restricted to admins or members of that specific organisation.
      allow read: if request.auth != null;
      allow create: if isHelmLogicAdmin() || 
                      (request.auth != null && 
                       request.resource.data.parentOrganisationId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId);
      allow update, delete: if isHelmLogicAdmin() || isMemberOfOrganisation(organisationId);
    }

    match /data-warehouse/{vendorId} {
      allow read: if request.auth != null;
      allow write: if isHelmLogicAdmin();

      match /ranges/{rangeId} {
        allow read: if request.auth != null;
        allow write: if isHelmLogicAdmin();

        match /models/{modelId} {
          allow read: if request.auth != null;
          allow write: if isHelmLogicAdmin();
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
