rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules - Prototyping Phase
     * 
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model for personal data and a collaborative 
     * membership model for shared client records. Security is primarily path-based or driven 
     * by denormalized authorization fields within documents.
     * 
     * Data Structure:
     * - /users/{userId}: Private user profiles.
     * - /roles_admin/{userId}: Global administrative flags (existence-based).
     * - /vessel_models/{vesselModelId}: Global read-only master catalog for all authenticated users.
     * - /clients/{clientId}: Shared records using denormalized 'ownerId' and 'members' maps.
     * - /users/{userId}/routes/...: User-specific maritime routes.
     * - /users/{userId}/quotes/...: User-specific quotes and their nested service items.
     * 
     * Key Security Decisions:
     * 1. Path-Based Security: Personal data (Quotes, Routes) is nested under /users/{userId}, 
     *    ensuring a user can only access their own data tree.
     * 2. Denormalization for Performance: Client documents store a 'members' map 
     *    (e.g., { 'uid': 'role' }) to allow shared access without expensive get() calls.
     * 3. Global Master Data: Vessel models are publicly readable by any signed-in user but 
     *    restricted for all writes.
     * 4. Administrative Access: Restricted to users present in the /roles_admin collection.
     */

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user owns the document and it exists for modification. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** @description Checks if the user is a collaborator or owner of a client document. */
    function isClientCollaborator(clientData) {
      return isSignedIn() && (
        clientData.ownerId == request.auth.uid || 
        request.auth.uid in clientData.members
      );
    }

    /** @description Checks if the user has a global admin role document. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- COLLECTION RULES ---

    /**
     * @description User profile documents. Users manage their own profile.
     * @path /users/{userId}
     * @allow get, list, create, update: if isOwner(userId)
     * @deny update: if request.auth.uid != userId
     * @principle Path-based ownership for user profiles.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false; // Profiles typically preserved in this system.
    }

    /**
     * @description Global admin roles. Restricted to admin-only or read-only for the user themselves.
     * @path /roles_admin/{userId}
     * @allow get: if isOwner(userId) || isAdmin()
     * @deny write: if true
     * @principle Administrative access managed via document existence.
     */
    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false; // Managed via administrative console/backend.
    }

    /**
     * @description Master catalog of vessel models. Read-only for all signed-in users.
     * @path /vessel_models/{vesselModelId}
     * @allow get, list: if isSignedIn()
     * @deny create, update, delete: if true
     * @principle Global master data with homogeneous read access.
     */
    match /vessel_models/{vesselModelId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Collaborative client records. Access granted via 'ownerId' or 'members' map.
     * @path /clients/{clientId}
     * @allow get, list: if isClientCollaborator(resource.data)
     * @allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
     * @allow update: if isClientCollaborator(resource.data) && resource.data.ownerId == request.resource.data.ownerId
     * @deny delete: if resource.data.ownerId != request.auth.uid
     * @principle Shared access model using denormalized membership for authorization independence.
     */
    match /clients/{clientId} {
      allow get, list: if isClientCollaborator(resource.data);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isClientCollaborator(resource.data) && resource != null && (request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isSignedIn() && resource != null && resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description User-owned maritime routes.
     * @path /users/{userId}/routes/{routeId}
     * @allow get, list, create, update, delete: if isOwner(userId)
     * @principle Path-based authorization for user-owned subcollections.
     */
    match /users/{userId}/routes/{routeId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isExistingOwner(userId);
    }

    /**
     * @description User-owned quotes. Manages the lifecycle of a quotation.
     * @path /users/{userId}/quotes/{quoteId}
     * @allow get, list, create, update, delete: if isOwner(userId)
     * @principle Ensures quote data remains private to the generating user.
     */
    match /users/{userId}/quotes/{quoteId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isExistingOwner(userId);

      /**
       * @description Line items associated with a specific quote.
       * @path /users/{userId}/quotes/{quoteId}/service_items/{serviceItemId}
       * @allow get, list, create, update, delete: if isOwner(userId)
       * @principle Inherited path-based authorization for deep subcollections.
       */
      match /service_items/{serviceItemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if isExistingOwner(userId);
      }
    }
  }
}