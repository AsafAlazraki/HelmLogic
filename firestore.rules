rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES - PROTOTYPING MODE
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- Core Data Warehouse & Shared Catalog ---

    match /data-warehouse/{vendorId} {
      allow read: if isSignedIn();
      match /{allPaths=**} {
        allow read: if isSignedIn();
      }
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
    }

    match /organisations/{organisationId} {
      allow read: if isSignedIn();
      
      match /exchangeRates/{code} {
        allow read, write: if isSignedIn();
      }
      
      match /pricingStrategies/{vendorId} {
        allow read, write: if isSignedIn();
      }

      match /dealerFitSelections/{id} {
        allow read, write: if isSignedIn();
      }

      match /dealerFitCategories/{id} {
        allow read, write: if isSignedIn();
      }
      
      match /modelOverrides/{modelId} {
        allow read, write: if isSignedIn();
      }
    }

    // --- Dashboard & Operational Logic ---

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    match /dealerFitCategories/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Prototype admin
    }

    // --- User Data & Templates ---

    match /users/{userId}/templates/{templateId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.createdByUserId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.createdByUserId == resource.data.createdByUserId;
      allow delete: if isExistingOwner(userId);

      match /documentTemplateContent/document {
        allow get, list: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      allow list: if false;
    }
  }
}