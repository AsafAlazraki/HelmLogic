
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(orgId) {
      return isSignedIn() && getUserData().organisationId == orgId;
    }

    function isSubDealerOf(orgId) {
      return isSignedIn() && getUserData().parentOrganisationId == orgId;
    }

    // --- Collection Rules ---

    match /organisations/{organisationId} {
      allow get: if isMemberOf(organisationId) || isSubDealerOf(organisationId) || isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
      
      match /dealerFitSelections/{selectionId} {
        allow get, list, create, update, delete: if isSignedIn();
      }
      
      match /quotes/{quoteId} {
        allow get, list, create, update, delete: if isSignedIn();
      }
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isSignedIn(); 
      allow delete: if false;
    }

    match /vessels/{vesselId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /vesselReservations/{reservationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if isOwner(userId);
      allow update: if isOwner(userId);
      allow create: if isSignedIn();
      allow delete: if false;
    }
    
    match /inventory/{itemId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    match /modules/{moduleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    match /dealerFitCategories/{catId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    match /data-warehouse/{vendorId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
      
      match /masterDataSet/{rowId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
      
      match /ranges/{rangeId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn();
        
        match /models/{modelId} {
          allow get, list: if isSignedIn();
          allow create, update, delete: if isSignedIn();
        }
      }
    }
  }
}
