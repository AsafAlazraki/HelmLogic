rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Core Data Warehouse & Shared Catalog ---

    match /data-warehouse/{vendorId} {
      allow read: if isSignedIn();
      match /{allPaths=**} {
        allow read: if isSignedIn();
      }
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
    }

    // --- Organisation Tree (Highly Permissive for Prototype) ---

    match /organisations/{organisationId} {
      // Allow broad read/write for any signed-in user within the org tree for prototype speed
      allow read, write: if isSignedIn();
      
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /dealerFitCategories/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Operational Logic ---

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    // --- User Data & Notifications ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isSignedIn();
      }
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isSignedIn();
      }
    }
  }
}