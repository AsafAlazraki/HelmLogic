rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules - Prototyping Phase
     * 
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model for personal data and a collaborative 
     * membership model for shared client records. Security is primarily path-based or driven 
     * by denormalized authorization fields within documents.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Robust Admin Check
     * Checks both the dedicated roles_admin collection and the UserProfile.appRole field.
     */
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'HelmLogic Admin')
      );
    }

    /**
     * Sub-dealer detection (v1.6) — a user is a sub-dealer when their
     * org has parentOrganisationId set. Used by Feature Tracking to gate
     * epics + features away from sub-dealers (commercial-roadmap
     * isolation per stakeholder spec).
     */
    function isSubDealer() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId != null &&
        exists(/databases/$(database)/documents/organisations/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId)) &&
        get(/databases/$(database)/documents/organisations/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId)).data.parentOrganisationId != null;
    }

    // --- COLLECTION RULES ---

    // HelmLogic Admins get full access to the entire database
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /quotes/{quoteId} {
        allow read, write: if isSignedIn();
        match /service_items/{itemId} {
          allow read, write: if isSignedIn();
        }
      }
      match /routes/{routeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /promotions/{promoId} {
        allow read, write: if isSignedIn();
      }
    }

    match /organisations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /templates/{templateId} {
        allow read, write: if isSignedIn();
      }
      match /modelOverrides/{modelId} {
        allow read, write: if isSignedIn();
      }
      match /trailerOverrides/{trailerId} {
        allow read, write: if isSignedIn();
      }
      match /exchangeRates/{code} {
        allow read, write: if isSignedIn();
        match /changeLog/{logId} {
          allow read, write: if isSignedIn();
        }
      }
      match /pricingStrategies/{vendorId} {
        allow read, write: if isSignedIn();
      }
      match /dealerFitSelections/{selectionId} {
        allow read, write: if isSignedIn();
      }
    }

    // Recursive permission for prototyping across the data-warehouse hierarchy
    match /data-warehouse/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Feature Tracking (v1.5 + v1.6).
    // v1.5: open to any signed-in user — create / vote / comment / drag /
    //       move status / set release / delete.
    // v1.6: gated AWAY from sub-dealer org users — they must NOT see the
    //       internal product roadmap (commercial isolation per stakeholder
    //       spec). HelmLogic staff + parent-dealer staff are still open.
    //       See tasks/v1.6-planning-system-design.md §3.
    match /features/{featureId} {
      allow read, write: if isSignedIn() && !isSubDealer();
      match /comments/{commentId} {
        allow read, write: if isSignedIn() && !isSubDealer();
      }
    }

    // Epics (v1.6) — first-class grouping for features. Same gating as
    // features.
    match /epics/{epicId} {
      allow read, write: if isSignedIn() && !isSubDealer();
    }

    match /dealerFitCategories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    match /delivered-deals/{dealId} {
      allow read, write: if isSignedIn();
    }

    match /holdRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    // Legacy support for clients collection
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }

    // Legacy support for global models
    match /vessel_models/{vesselModelId} {
      allow read: if isSignedIn();
    }
  }
}
