rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HELMLOGIC SECURITY RULES
     *
     * Global Admin bypass + Multi-tenant organization model.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user has the HelmLogic Admin role in their profile. */
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('appRole', '') == 'HelmLogic Admin';
    }

    /** @description Checks if the user is a member of a specific organisation or a global admin. */
    function isOrgMember(orgId) {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('organisationId', '') == orgId
        ) ||
        (
          exists(/databases/$(database)/documents/organisations/$(orgId)) && 
          request.auth.uid in get(/databases/$(database)/documents/organisations/$(orgId)).data.get('members', [])
        )
      );
    }

    // --- GLOBAL ADMIN BYPASS ---
    
    /** 
     * @description HelmLogic Admins can do everything. 
     * This is the master override for all paths.
     */
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for User Profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow create, update: if isSignedIn() && (request.auth.uid == userId);
      allow list: if isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId);
      }
    }

    /**
     * @description Rules for the Data Warehouse. 
     */
    match /data-warehouse/{vendorId} {
      allow get, list: if isSignedIn();
      match /{allSubcollections=**} {
        allow get, list: if isSignedIn();
      }
    }

    /**
     * @description Rules for application modules.
     */
    match /modules/{moduleId} {
      allow get, list: if isSignedIn();
    }

    /**
     * @description Rules for global dealer fit categories.
     */
    match /dealerFitCategories/{catId} {
      allow get, list: if isSignedIn();
    }

    /**
     * @description Rules for Organisations.
     * Allow get/list for all signed in users to support slug-based lookups and role switching.
     */
    match /organisations/{organisationId} {
      allow get, list: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOrgMember(organisationId);

      /**
       * Sub-collections: priceLevelDefinitions, productPrices, quotes, dealerFitSelections, inventory, etc.
       * These are protected by organization membership.
       */
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && isOrgMember(organisationId);
      }
    }

    /**
     * @description Global reference data and legacy support.
     */
    match /brands/{brandId} { allow get, list: if isSignedIn(); }
    match /products/{productId} { allow get, list: if isSignedIn(); }
    
    /**
     * @description Global collections for inventory/vessels.
     */
    match /inventory/{itemId} { 
      allow read, write: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.get('organisationId', ''))); 
    }
    match /vessels/{vesselId} { 
      allow read, write: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.get('organisationId', ''))); 
    }
    match /vesselReservations/{resId} { 
      allow read, write: if isSignedIn(); 
    }
  }
}