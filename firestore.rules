rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isHelmLogicAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'HelmLogic Admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == orgId;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isHelmLogicAdmin();
      allow list: if isHelmLogicAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isHelmLogicAdmin();
      allow delete: if isHelmLogicAdmin();

      // Legacy path-based subcollections
      match /vessels/{vesselId} {
        allow read, write: if isOwner(userId) || isHelmLogicAdmin();
        match /routes/{routeId} {
          allow read, write: if isOwner(userId) || isHelmLogicAdmin();
          match /waypoints/{waypointId} {
            allow read, write: if isOwner(userId) || isHelmLogicAdmin();
          }
        }
        match /location_updates/{updateId} {
          allow read, write: if isOwner(userId) || isHelmLogicAdmin();
        }
      }
      match /route_optimization_records/{recordId} {
        allow read, write: if isOwner(userId) || isHelmLogicAdmin();
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isHelmLogicAdmin();
      }
      match /quotes/{quoteId} {
        allow read, write: if isOwner(userId) || isHelmLogicAdmin();
      }
    }

    // --- Organisations ---
    match /organisations/{organisationId} {
      allow get, list: if isSignedIn();
      allow create: if isHelmLogicAdmin();
      allow update: if isHelmLogicAdmin() || (isOrgMember(organisationId) && get(/databases/$(database)/documents/organisations/$(organisationId)).data.permissions[request.auth.uid].can_access_settings == true);
      allow delete: if isHelmLogicAdmin();

      match /dealerFitSelections/{selectionId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
      match /modelOverrides/{modelId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
      match /pricingStrategies/{vendorId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
      match /priceLevelDefinitions/{levelId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
      match /productPrices/{priceId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
    }

    // --- Data Warehouse ---
    match /data-warehouse/{vendorId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isHelmLogicAdmin();

      match /{allSubcollections=**} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isHelmLogicAdmin();
      }
    }

    // --- Modules ---
    match /modules/{moduleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isHelmLogicAdmin();
    }

    // --- Dealer Fit Categories ---
    match /dealerFitCategories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isHelmLogicAdmin();
    }

    // --- Global Entities (Org Scoped via Query) ---
    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }
    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }
    match /vesselReservations/{resId} {
      allow read, write: if isSignedIn();
    }
    match /brands/{brandId} {
      allow read: if isSignedIn();
      allow write: if isHelmLogicAdmin();
    }
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isHelmLogicAdmin();
    }
  }
}