rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules
     * 
     * Core Philosophy:
     * This ruleset implements a multi-tenant, hierarchical authorization model based on 
     * Organisations. Access is primarily determined by a user's affiliation with an 
     * Organisation or their role as a Sub-Dealer to a Parent Organisation.
     * 
     * Data Structure:
     * - /organisations: Top-level collection for all entity groups.
     * - /users: Source of truth for user profiles and organisation context (DBAC).
     * - /vessels: Managed assets owned by parent organisations, viewable by sub-dealers.
     * - /vesselReservations: Shared collaboration documents between sub-dealers and parents.
     * - /users/{userId}/notifications: Private user-specific messaging.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(orgId) {
      return isSignedIn() && getUserData().organisationId == orgId;
    }

    function isSubDealerOf(orgId) {
      return isSignedIn() && getUserData().parentOrganisationId == orgId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /organisations/{organisationId} {
      allow get: if isMemberOf(organisationId) || isSubDealerOf(organisationId) || isSignedIn(); // Allow get for signed in users for prototype
      allow list: if isSignedIn(); // Required for role switching and organization discovery in prototype
      allow create, update, delete: if isSignedIn(); // Simplified for prototyping
      
      // Sub-collections within an organisation
      match /dealerFitSelections/{selectionId} {
        allow get, list, create, update, delete: if isSignedIn();
      }
      
      match /quotes/{quoteId} {
        allow get, list, create, update, delete: if isSignedIn();
      }
    }

    match /users/{userId} {
      allow get: if isSignedIn(); // Allow reading other users for notifications logic
      allow list: if isSignedIn(); // Allow discovery for prototype
      allow create: if isOwner(userId);
      allow update: if isSignedIn(); 
      allow delete: if false;
    }

    match /vessels/{vesselId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /vesselReservations/{reservationId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow create: if isSignedIn(); // Allow creation by other users/system logic for prototype
      allow delete: if false;
    }
    
    // Inventory collection
    match /inventory/{itemId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    // Modules collection
    match /modules/{moduleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    // Dealer Fit Categories
    match /dealerFitCategories/{catId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
    
    // Data Warehouse
    match /data-warehouse/{vendorId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
      
      match /masterDataSet/{rowId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
      
      match /ranges/{rangeId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn();
        
        match /models/{modelId} {
          allow get, list: if isSignedIn();
          allow create, update, delete: if isSignedIn();
        }
      }
    }
  }
}