rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- Core Data Warehouse & Shared Catalog ---

    match /data-warehouse/{vendorId} {
      allow read: if isSignedIn();
      match /{allPaths=**} {
        allow read: if isSignedIn();
      }
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
    }

    match /organisations/{organisationId} {
      allow read, write: if isSignedIn();
      
      // Templates are nested in organisations for professional management
      match /templates/{templateId} {
        allow read, write: if isSignedIn();
        match /{allPaths=**} {
          allow read, write: if isSignedIn();
        }
      }
      
      // Explicit recursive wildcard for all sub-data in organisations
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    // --- Dashboard & Operational Logic ---

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    match /dealerFitCategories/{id} {
      allow read: if isSignedIn();
    }

    // --- User Data & Notifications ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
      allow list: if isSignedIn();

      match /notifications/{notificationId} {
        allow get, list, write: if isOwner(userId);
      }
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}