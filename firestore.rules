rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HELMLOGIC PRICE BOOK SECURITY RULES
     *
     * Multi-tenant organization model with global reference data.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user has the HelmLogic Admin role. */
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'HelmLogic Admin';
    }

    /** @description Checks if the user is a member of a specific organisation or a global admin. */
    function isOrgMember(orgId) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/organisations/$(orgId)) && 
         (
           ('members' in get(/databases/$(database)/documents/organisations/$(orgId)).data && request.auth.uid in get(/databases/$(database)/documents/organisations/$(orgId)).data.members) ||
           (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == orgId)
         )
        )
      );
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for User Profiles. Users can manage their own profile.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow list: if isAdmin();
      
      // Allow users to have sub-collections like notifications
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    /**
     * @description Rules for the Data Warehouse. 
     * Reference data is readable by all signed-in users.
     * Only Admins can modify master data.
     */
    match /data-warehouse/{vendorId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /{allSubcollections=**} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    /**
     * @description Rules for application modules.
     */
    match /modules/{moduleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for global dealer fit categories.
     */
    match /dealerFitCategories/{catId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for Organisations. Root of the multi-tenant hierarchy.
     */
    match /organisations/{organisationId} {
      allow get: if isOrgMember(organisationId);
      allow list: if isSignedIn(); // Allow signed in users to list for joining/switching
      allow create: if isSignedIn();
      allow update: if isOrgMember(organisationId);
      allow delete: if isAdmin();

      /**
       * Sub-collections: priceLevelDefinitions, productPrices, quotes, dealerFitSelections, inventory, vessels, etc.
       */
      match /{allSubcollections=**} {
        allow get, list: if isOrgMember(organisationId);
        allow create, update, delete: if isOrgMember(organisationId);
      }
    }

    /**
     * @description Legacy global collections support.
     */
    match /brands/{brandId} { allow get, list: if isSignedIn(); }
    match /products/{productId} { allow get, list: if isSignedIn(); }
    
    /**
     * @description Global collections for inventory/vessels if not nested.
     */
    match /inventory/{itemId} { allow read, write: if isSignedIn(); }
    match /vessels/{vesselId} { allow read, write: if isSignedIn(); }
    match /vesselReservations/{resId} { allow read, write: if isSignedIn(); }
  }
}
