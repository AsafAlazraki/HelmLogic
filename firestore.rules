rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HELMLOGIC SECURITY RULES
     *
     * Global Admin bypass + Multi-tenant organization model.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user has the HelmLogic Admin role in their profile. */
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('appRole', '') == 'HelmLogic Admin';
    }

    /** @description Checks if the user is a member of a specific organisation, a global admin, or a member of the parent organisation. */
    function isOrgMember(orgId) {
      if (!isSignedIn()) return false;
      if (isAdmin()) return true;
      
      // Get user's primary organisation
      let userProfilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userOrgId = exists(userProfilePath) ? get(userProfilePath).data.get('organisationId', '') : '';
      
      // 1. Direct membership via profile
      if (userOrgId == orgId) return true;
      
      // 2. Parent-Child relationship (Org managers can manage their sub-dealers)
      let targetOrgPath = /databases/$(database)/documents/organisations/$(orgId);
      if (exists(targetOrgPath)) {
        let targetOrg = get(targetOrgPath).data;
        // If the target's parent is the user's org, allow access
        if (targetOrg.get('parentOrganisationId', '') == userOrgId) return true;
        // Direct membership via members array
        if (request.auth.uid in targetOrg.get('members', [])) return true;
      }
      
      return false;
    }

    // --- GLOBAL ADMIN BYPASS ---
    
    /** 
     * @description HelmLogic Admins can do everything. 
     * This is the master override for all paths.
     */
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for User Profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    /**
     * @description Rules for Organisations.
     */
    match /organisations/{organisationId} {
      // Allow get/list for discovery and context switching
      allow get, list: if isSignedIn(); 
      // Allow creation for signups or admin
      allow create: if isSignedIn();
      // Allow update if member, admin, or parent organization member
      allow update: if isSignedIn() && isOrgMember(organisationId);

      /**
       * Sub-collections: priceLevelDefinitions, productPrices, quotes, dealerFitSelections, inventory, etc.
       */
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && isOrgMember(organisationId);
      }
    }

    /**
     * @description Rules for the Data Warehouse.
     */
    match /data-warehouse/{vendorId} {
      allow get, list: if isSignedIn();
      match /{allSubcollections=**} {
        allow get, list: if isSignedIn();
      }
    }

    /**
     * @description Global collections for inventory/vessels.
     */
    match /inventory/{itemId} { 
      allow read, write: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.get('organisationId', ''))); 
    }
    match /vessels/{vesselId} { 
      allow read, write: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.get('organisationId', ''))); 
    }
    match /vesselReservations/{resId} { 
      allow read, write: if isSignedIn(); 
    }
    
    /**
     * @description Global reference data.
     */
    match /brands/{brandId} { allow get, list: if isSignedIn(); }
    match /products/{productId} { allow get, list: if isSignedIn(); }
    match /modules/{moduleId} { allow get, list: if isSignedIn(); }
    match /dealerFitCategories/{catId} { allow get, list: if isSignedIn(); }
  }
}