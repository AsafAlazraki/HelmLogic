rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules - Prototyping Phase
     * 
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model for personal data and a collaborative 
     * membership model for shared client records. Security is primarily path-based or driven 
     * by denormalized authorization fields within documents.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Robust Admin Check
     * Checks both the dedicated roles_admin collection and the UserProfile.appRole field.
     */
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'HelmLogic Admin')
      );
    }

    /**
     * v1.8 (story 1.3.1.a) — Quote-lock guard. Returns true when an
     * update to a locked quote ONLY touches fields in the lock-related
     * whitelist. Used in /users/{uid}/quotes/{qid} update rule to allow
     * unlock + re-send denormalisation while blocking arbitrary edits
     * to a locked quote (so power-users can't bypass via dev tools).
     */
    function onlyLockFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'isLocked', 'lockedAt', 'lockedByUid', 'lockedByName', 'lockedReason',
        'lastSentAt', 'sentCount',
        'updatedAt'
      ]);
    }

    /**
     * v1.33 (Mark: "can't remove a quote from my list") — soft-delete /
     * archive guard. Removing a quote from lists sets `deletedAt` (the doc
     * and its sub-collections stay for audit). A LOCKED (sent) quote could
     * never take this update because deletedAt wasn't on any whitelist —
     * the exact failure Mark hit. Restore (deletedAt -> null) rides the
     * same guard.
     */
    function onlySoftDeleteFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'deletedAt', 'lastUpdateAt', 'updatedAt'
      ]);
    }

    /**
     * v1.9 (story 1.4.1) — Quote lifecycle-state guard. Returns true when
     * an update ONLY touches lifecycle-state fields, so a LOCKED quote can
     * still transition through its sales journey (Sent → Viewed → Accepted
     * etc.) without the lock blocking the state machine. The lock layer
     * gates CONTENT edits; the lifecycle layer is orthogonal.
     */
    function onlyLifecycleFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lifecycleState', 'lifecycleStateAt', 'lifecycleStateByUid', 'lifecycleStateByName',
        'updatedAt'
      ]);
    }

    /**
     * v1.9 (story 1.3.3) — SharePoint sync-tracking guard. Returns true
     * when an update ONLY touches sync-tracking fields written by the
     * SharePoint sync orchestrator after a successful Graph upload. Lets
     * the sync stamp `sharePointSyncedAt` / `sharePointPath` /
     * `sharePointWebUrl` on LOCKED quotes (Send auto-locks, then sync
     * runs immediately after — without this allowance, post-send sync
     * would be blocked by the lock rule).
     */
    function onlySharePointFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'sharePointSyncedAt', 'sharePointPath', 'sharePointWebUrl',
        'updatedAt'
      ]);
    }

    // --- COLLECTION RULES ---

    // HelmLogic Admins get full access to the entire database
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      // Structure-audit P1 (2026-07-04, H4): hold requests and @-mentions
      // write OTHER users' notifications (hold-request-dialog notifies the
      // brand captain, hold-requests-dashboard notifies the requester,
      // lib/notifications.ts is the generic helper). Any signed-in user
      // may CREATE a notification for anyone; reading, editing and
      // deleting stay owner/admin-only.
      match /notifications/{notifId} {
        allow create: if isSignedIn();
        allow read, update, delete: if isOwner(userId) || isAdmin();
      }
      match /quotes/{quoteId} {
        // v1.8 (story 1.3.1.a) — quote-lock enforcement at the rules
        // layer. Reads + create + delete unchanged (any signed-in user,
        // matches v1.0 cross-user collaboration model). Update splits:
        //   - If the existing doc is NOT locked → allow any update.
        //   - If the existing doc IS locked → only allow updates that
        //     touch lock-related fields (isLocked, lockedAt, lockedByUid,
        //     lockedByName, lockedReason, lastSentAt, sentCount, updatedAt).
        // Power-users with browser dev tools can't bypass the lock
        // by writing arbitrary fields directly to Firestore.
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn();
        allow update: if isSignedIn() && (
          !(resource.data.isLocked == true)
          || onlyLockFieldsChanged()
          || onlyLifecycleFieldsChanged()
          || onlySharePointFieldsChanged()
          || onlySoftDeleteFieldsChanged()
        );
        match /service_items/{itemId} {
          allow read, write: if isSignedIn();
        }
        // v1.8 (story 1.4.1) — Quote audit log subcollection. Captures
        // every lifecycle event (created / finalised / sent / locked /
        // unlocked / version-forked / content-overridden / discount-
        // changed) so the Activity tab can render an audit trail.
        // Reads + writes signed-in (matches the rest of the quote
        // subcollections). Server-side write enforcement (rules block
        // tampering) is a v1.9 candidate.
        match /auditLog/{eventId} {
          allow read, write: if isSignedIn();
        }
        // v1.8 (story 1.2.4.a) — Sent-email audit records. Every Send
        // Quote action writes a sentEmails/{sendId} doc capturing
        // recipient, frozen subject/body, PDF storage path, status,
        // and the FK into mail/{id} for delivery tracking. Reads +
        // writes signed-in (matches sibling quote subcollections).
        match /sentEmails/{sendId} {
          allow read, write: if isSignedIn();
        }
        // v1.8 (story 1.2.3) — Per-quote content overrides. Doc id is
        // the blockType (one override per block per quote). Salespeople
        // use the Personalise side sheet on the proposal view to author
        // these; the lock flag on the parent contentBlock controls
        // whether the override layer is honoured by the resolver. Reads
        // + writes signed-in (matches sibling quote subcollections).
        match /contentOverrides/{blockType} {
          allow read, write: if isSignedIn();
        }
        // v1.19 (Story 2.3.1) — Post-contract quote variations. Sit
        // under the parent quote so they inherit the user-owns model.
        // Reads + writes signed-in; quote-lock + variation-status
        // gating handled at the UI layer (canTransitionVariationStatus
        // in src/lib/catalog/quote-variation.ts).
        match /variations/{variationId} {
          allow read, write: if isSignedIn();
        }
        // v1.20 (Story 2.4.1) — Contracts created when a quote is
        // converted. Immutable line-item snapshot. Subsequent changes
        // flow through variations or a re-converted contract.
        match /contracts/{contractId} {
          allow read, write: if isSignedIn();
          // v1.20 (Story 2.4.2) — Deposits recorded against a contract.
          // Each deposit also gets a receipt PDF generated from the
          // v1.18 pdf-branding.ts tokens.
          match /deposits/{depositId} {
            allow read, write: if isSignedIn();
          }
        }
      }
      match /routes/{routeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // v1.21 (Story 8.1.4 + 8.2.1) — collection-group reads of quotes.
    // The path-scoped /users/{uid}/quotes/{qid} rule above does NOT
    // enable collectionGroup('quotes') queries; Firestore requires a
    // recursive-wildcard rule for that. The reporting dashboard +
    // cross-module quotes view + customer detail sheet all run
    // collectionGroup('quotes') filtered by organisationId / customerId.
    // Reads signed-in (org-scoping enforced in the query's where()).
    // Writes stay on the path-scoped rule above (no write via group).
    match /{path=**}/quotes/{quoteId} {
      allow read: if isSignedIn();
    }

    // v1.22 (Story 8.1.5) — collection-group reads of contracts for the
    // cross-module Contracts view. Same rationale as the quotes rule
    // above. Writes stay on the path-scoped rule under the quote subtree.
    match /{path=**}/contracts/{contractId} {
      allow read: if isSignedIn();
    }

    // v1.22 (Story 1.7.3) — collection-group reads of auditLog for the
    // recent-activity feed. Writes stay on the path-scoped quote auditLog
    // rule. Read signed-in.
    match /{path=**}/auditLog/{eventId} {
      allow read: if isSignedIn();
    }

    // v1.20 (Story 2.6.3) — collection-group reads of variations for the
    // public accept-variation page. It looks a variation up by its
    // unguessable publicAcceptToken via collectionGroup('variations'),
    // authenticated anonymously (signInAnonymously). Anonymous users are
    // signed-in, so isSignedIn() permits the token lookup; the token
    // itself is the access control. Writes stay on the path-scoped
    // users/{uid}/quotes/{qid}/variations rule.
    match /{path=**}/variations/{variationId} {
      allow read: if isSignedIn();
    }

    // Structure-audit P0 (2026-07-03): collectionGroup reads used by
    // stock-import, delivered-deals-import and maritime-assistant —
    // data-warehouse/{allPaths=**} does NOT satisfy group queries.
    match /{path=**}/models/{modelId} {
      allow read: if isSignedIn();
    }
    match /{path=**}/ranges/{rangeId} {
      allow read: if isSignedIn();
    }

    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /promotions/{promoId} {
        allow read, write: if isSignedIn();
      }

      // v1.9 (1.1.2) — Feature × feature compatibility rules.
      // Authored direct to Firestore by engineering for v1.9; admin UI
      // deferred to v1.10+.
      match /compatibilityRules/{ruleId} {
        allow read, write: if isSignedIn();
      }
    }

    match /organisations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /templates/{templateId} {
        allow read, write: if isSignedIn();
      }
      match /modelOverrides/{modelId} {
        allow read, write: if isSignedIn();
      }
      match /trailerOverrides/{trailerId} {
        allow read, write: if isSignedIn();
      }
      match /exchangeRates/{code} {
        allow read, write: if isSignedIn();
        match /changeLog/{logId} {
          allow read, write: if isSignedIn();
        }
      }
      match /pricingStrategies/{vendorId} {
        allow read, write: if isSignedIn();
      }
      match /dealerFitSelections/{selectionId} {
        allow read, write: if isSignedIn();
      }
      // v1.10 (Epic 9.1.x — Fit-Up admin) — Master Fit-Up Catalog.
      // Org-level library of fit-up items (name, tier, cost,
      // sellPrice?, notes?). Reads + writes signed-in; UI-layer
      // org-admin gate enforced via /manage's can_access_settings
      // permission (matches the rest of the org subcollection
      // pattern). Quote-flow integration ships with Epic 9.2 in v1.16+.
      match /fitUpItems/{itemId} {
        allow read, write: if isSignedIn();
      }
      // v1.11 expansion — Fit-Up packages. Named bundles of fit-up
      // item ids (e.g. "Coastal Setup" = SUP rack + GPS install +
      // safety pack). Selecting a package in the quote flow toggles
      // every member item on/off. Lives at
      // /organisations/{orgId}/fitUpPackages/{packageId}. Shape:
      //   { name: string, description?: string,
      //     itemIds: string[]  // ids in /fitUpItems
      //     createdAt, updatedAt }
      // Reads + writes signed-in; UI-layer org-admin gate via /manage's
      // can_access_settings permission (matches /fitUpItems).
      match /fitUpPackages/{packageId} {
        allow read, write: if isSignedIn();
      }
      // v1.15 (Story 9.3.1) — Operator-authored classification rules that
      // auto-suggest a fit-up tier from the quote context. Same lenient
      // policy as fitUpPackages — UI-layer can_access_settings gates write.
      match /fitUpClassificationRules/{ruleId} {
        allow read, write: if isSignedIn();
      }
      // v1.11 expansion-2 — Fit-Up catalog audit log. Append-only log of
      // catalog mutations (item/package created / updated / deleted).
      // Reads + writes signed-in; UI-layer org-admin gate via /manage's
      // can_access_settings permission. Pattern mirrors per-quote
      // auditLog. Log writes are fire-and-forget (see
      // src/lib/fit-up-catalog-audit.ts) — a denied write on this path
      // must not roll back the underlying catalog mutation.
      match /fitUpCatalogAudit/{eventId} {
        allow read, write: if isSignedIn();
      }

      // v1.11 follow-up — catalog-wide audit trail (import commits + manual
      // edits). Same lenient policy as fitUpCatalogAudit because every
      // catalog write should append a non-blocking audit record (fire-and-
      // forget); a denied write on this path must not roll back the
      // underlying catalog mutation.
      match /catalogAudit/{eventId} {
        allow read, write: if isSignedIn();
      }
      // v1.10 (Epic 11.1.1 — Service-quote schema) — Service-quoting
      // catalogue. Two sister subcollections that hold the labor codes
      // and parts catalog used by the service-quote flow (Epic 11.2+,
      // v1.11+) and populated by the NSM-Hub migration (Epic 11.3+).
      //
      // serviceOperations/{opId}: labor codes — { code, name,
      //   flatRateHours, hourlyRate, cost?, sellPrice?, notes? }.
      //   Sell price derives from flatRateHours × hourlyRate unless
      //   sellPrice is explicitly overridden.
      // serviceParts/{partId}: parts catalog — { partNumber, name,
      //   cost, sellPrice?, stockLevel?, notes? }. Part number is the
      //   natural key on import (upsert match, never clear-and-replace).
      //
      // Reads + writes signed-in (matches the rest of the org
      // subcollection pattern); UI-layer org-admin gate via
      // /manage's can_access_settings permission.
      match /serviceOperations/{opId} {
        allow read, write: if isSignedIn();
      }
      match /serviceParts/{partId} {
        allow read, write: if isSignedIn();
      }
      // MPF migration (2026-07) — collections created to hold NSM's
      // Master Price File data 1:1 (see tasks/mpf-audit/MAPPING.md).
      // Same lenient org-subcollection policy as their siblings above;
      // UI-layer org-admin gate via /manage's can_access_settings.
      //
      // riggingKits/{kitId}: rigging kit catalog (3-tier ex-GST pricing,
      //   install hours at org shop rate, components, inclusion flags).
      // suppliers/{supplierId}: supplier registry (name/ABN/terms/credit
      //   + DMS invoice config).
      // supplierPriceLists/{listId}: vendor cost-refresh price lists
      //   (per-org per decision D5).
      // pricingMatrix/{rowId}: per-franchise markup/margin + trade tiers
      //   + retail sliding scale (the MPF "Price Matrix" brain).
      // engineServiceSchedules/{engineId}: per-engine service interval
      //   price matrix + 5-year plans + parts BOM.
      // freightConfig/{vendorId}: per-vendor per-linear-metre freight
      //   rates + buffer feeding boat landed cost.
      match /riggingKits/{kitId} {
        allow read, write: if isSignedIn();
      }
      // Structure-audit P0: live price-list manager surface (modules/[id]).
      match /priceLists/{listId} {
        allow read, write: if isSignedIn();
      }
      // Structure-audit P0: v1.13 service-quote Send pipeline writes these
      // awaited subcollections; unruled = pipeline breaks when email flips on.
      match /serviceQuotes/{sqId}/sentEmails/{sendId} {
        allow read, write: if isSignedIn();
      }
      match /serviceQuotes/{sqId}/auditLog/{eventId} {
        allow read, write: if isSignedIn();
      }
      match /suppliers/{supplierId} {
        allow read, write: if isSignedIn();
      }
      match /supplierPriceLists/{listId} {
        allow read, write: if isSignedIn();
      }
      match /pricingMatrix/{rowId} {
        allow read, write: if isSignedIn();
      }
      match /engineServiceSchedules/{engineId} {
        allow read, write: if isSignedIn();
      }
      match /freightConfig/{vendorId} {
        allow read, write: if isSignedIn();
      }
      // v1.11 (Epic 11.2.1 — Service-quote flow) — Service quotes
      // composed from serviceOperations + serviceParts on a customer.
      // Owned by the org so multiple service advisors can collaborate.
      // Reads + writes signed-in; UI-layer gates editing on
      // can_access_settings (org-admin / service-advisor role).
      match /serviceQuotes/{quoteId} {
        allow read, write: if isSignedIn();
      }
      // v1.7 (story 1.8.1) — Quote Content Block Manager.
      // Reads open to all org members so the PDF render works for
      // every salesperson; writes nominally signed-in to match the
      // sibling org subcollections, with the org-admin gate enforced
      // at the UI layer (organisation.permissions[role].can_access_settings,
      // same gate the parent /manage page uses). Same rationale as
      // the v1.6.1 sub-dealer rule removal — rule-layer org-admin
      // checks have false-positive risks; UI gating is the
      // authoritative layer in this codebase.
      match /contentBlocks/{blockId} {
        allow read, write: if isSignedIn();
        match /brandOverrides/{vendorId} {
          allow read, write: if isSignedIn();
        }
        match /versions/{versionId} {
          allow read, write: if isSignedIn();
        }
      }
      // v1.7 (story 1.8.11) — PDF Section Structure (drag-drop reorder).
      // organisations/{orgId}/pdfStructure/{documentType} where
      // documentType ∈ ('quote' | 'contract'). Same isSignedIn() gating
      // as the rest of the org subcollections; UI gates editing on
      // organisation.permissions[role].can_access_settings.
      match /pdfStructure/{documentType} {
        allow read, write: if isSignedIn();
      }
      // v1.7 (story 1.8.12) — Sales Team per-salesperson messages + photos.
      // organisations/{orgId}/salesTeam/{userId}. Doc id === user uid.
      // Reads open so the customer-PDF render can resolve the salesperson
      // for any quote.createdByUid; writes signed-in (UI gates org-admin
      // edit access via /manage's can_access_settings permission).
      match /salesTeam/{userId} {
        allow read, write: if isSignedIn();
      }
      // v1.8 (story 1.2.4.a) — Email templates per org. Per-template-type
      // (send-quote / send-contract / follow-up); the v1.2.4.b authoring
      // surface lives at /manage → Document Templates → Email tab. Reads
      // open to all org members (the Send Quote dialog needs to pick a
      // template at send time); writes signed-in with UI-layer can_access_settings
      // gating, consistent with the rest of the org subcollection pattern.
      match /emailTemplates/{templateId} {
        allow read, write: if isSignedIn();
      }
      // v1.33 (Epic 14 — Usage Reporting) — telemetry. Sessions carry
      // active/idle time per app-open; events are the batched click/nav/
      // action stream. Any signed-in org member writes their own capture
      // and reads the reports (org-scoped by path). Updates allowed so the
      // session heartbeat can increment counters; deletes admin-only so
      // nobody can scrub their own usage history.
      match /activitySessions/{sessionId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isAdmin();
      }
      match /activityEvents/{eventId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
      // v1.9 (story 1.3.3) — SharePoint integration config. Single doc
      // per org at `default`. Public identifiers only (tenantId, clientId,
      // siteId, folderPath) — the Azure app client secret lives in
      // Firebase App Hosting backend env (SHAREPOINT_CLIENT_SECRET) and
      // never touches Firestore. Reads open for the client to know
      // whether sync is configured before firing the hook; writes
      // signed-in with UI-layer can_access_settings gating in
      // sharepoint-config-editor.tsx.
      match /sharePointConfig/{configId} {
        allow read, write: if isSignedIn();
      }
    }

    // Recursive permission for prototyping across the data-warehouse hierarchy
    match /data-warehouse/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Feature Tracking (v1.5 + v1.6).
    // Open to any signed-in user. Sub-dealer hiding is enforced
    // client-side (sidebar hides the link, page-level gate shows
    // "Not available for sub-dealer accounts"). The rule-layer
    // sub-dealer check was removed in v1.6.1 because it falsely
    // denied parent-dealer admins (e.g. billh@nsmarine.com.au).
    // See post-mortem in tasks/v1.6-planning-system-status.md.
    match /features/{featureId} {
      allow read, write: if isSignedIn();
      match /comments/{commentId} {
        allow read, write: if isSignedIn();
      }
      // Structure-audit P1 (2026-07-04, H5): the suggestion approval
      // queue writes an audit event under the feature on approve/reject;
      // the recursive /{path=**}/auditLog rule is read-only, so without
      // this block those writes 403 for non-HelmLogic-admins.
      match /auditLog/{eventId} {
        allow read, write: if isSignedIn();
      }
    }

    // Epics (v1.6) — same gating as features.
    match /epics/{epicId} {
      allow read, write: if isSignedIn();
    }

    // Trigger Email extension queue (v1.6).
    // Any signed-in user can enqueue an email (used by @-mention
    // notifications + the "Send test email" button). Only admins can
    // read the queue (audit trail).
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /dealerFitCategories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    match /delivered-deals/{dealId} {
      allow read, write: if isSignedIn();
    }

    match /holdRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn();
      // v1.24 (Story 1.5.3) — customer notes timeline.
      match /notes/{noteId} {
        allow read, write: if isSignedIn();
      }
    }

    // Legacy support for clients collection
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }

    // Legacy support for global models
    match /vessel_models/{vesselModelId} {
      allow read: if isSignedIn();
    }
  }
}
