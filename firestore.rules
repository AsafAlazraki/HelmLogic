rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Core Data Warehouse & Shared Catalog ---

    match /data-warehouse/{vendorId} {
      allow read: if isSignedIn();
      match /{allPaths=**} {
        allow read: if isSignedIn();
      }
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
    }

    match /organisations/{organisationId} {
      // Allow global read for organization details
      allow read: if isSignedIn();
      // Allow write for any authenticated user for prototype purposes
      allow write: if isSignedIn();
      
      match /templates/{templateId} {
        allow read, write: if isSignedIn();
        match /{allPaths=**} {
          allow read, write: if isSignedIn();
        }
      }
      
      match /dealerFitSelections/{selectionId} {
        allow read, write: if isSignedIn();
      }

      match /exchangeRates/{currencyCode} {
        allow read, write: if isSignedIn();
        match /{allPaths=**} {
          allow read, write: if isSignedIn();
        }
      }

      match /pricingStrategies/{vendorId} {
        allow read, write: if isSignedIn();
      }

      match /modelOverrides/{modelId} {
        allow read, write: if isSignedIn();
      }
      
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /dealerFitCategories/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Operational Logic ---

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    // --- User Data & Notifications ---

    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow creation for signup and enrollment
      allow create: if isSignedIn();
      // Allow update for profile management
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isSignedIn();
      }
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isSignedIn();
      }
    }
  }
}