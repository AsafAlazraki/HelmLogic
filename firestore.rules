
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isHelmLogicAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null && 
             userDoc.data != null &&
             'appRole' in userDoc.data && 
             userDoc.data.appRole == 'HelmLogic Admin';
    }

    function isMemberOfOrganisation(organisationId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null &&
             userDoc.data != null &&
             'organisationId' in userDoc.data &&
             userDoc.data.organisationId == organisationId;
    }
    
    function isParentOfOrganisation(childOrganisationId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let childOrgDoc = get(/databases/$(database)/documents/organisations/$(childOrganisationId));
      return request.auth != null &&
             userDoc.data != null &&
             'organisationId' in userDoc.data &&
             childOrgDoc.data != null &&
             'parentOrganisationId' in childOrgDoc.data &&
             childOrgDoc.data.parentOrganisationId == userDoc.data.organisationId;
    }

    match /users/{userId} {
      // A user can create their own user document.
      allow create: if request.auth.uid == userId;

      // A user can read their own user document.
      allow read: if request.auth.uid == userId;

      // A user can update their own user document.
      allow update: if request.auth.uid == userId;

      // Deletes are not allowed.
      allow delete: if false;
    }

    match /organisations/{organisationId} {
      allow read: if request.auth != null;
      allow create: if isHelmLogicAdmin() || 
                      (request.auth != null && 
                       request.resource.data.parentOrganisationId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId);
      allow update, delete: if isHelmLogicAdmin() || isMemberOfOrganisation(organisationId);
      
      match /quotes/{quoteId} {
        allow read: if isMemberOfOrganisation(organisationId) || isParentOfOrganisation(organisationId) || isHelmLogicAdmin();
        allow create, update, delete: if isMemberOfOrganisation(organisationId) || isHelmLogicAdmin();
      }

      match /dealerFitSelections/{selectionId} {
        allow read, write: if isMemberOfOrganisation(organisationId) || isHelmLogicAdmin();
      }
    }

    match /data-warehouse/{vendorId} {
      allow read: if request.auth != null;
      allow write: if isHelmLogicAdmin();
    }

    match /data-warehouse/{vendorId}/masterDataSet/{rowId} {
      allow read: if request.auth != null;
      allow write: if isHelmLogicAdmin();
    }

    match /data-warehouse/{vendorId}/ranges/{rangeId} {
      allow read: if request.auth != null;
      allow write: if isHelmLogicAdmin();
    }

    match /data-warehouse/{vendorId}/ranges/{rangeId}/models/{modelId} {
      allow read: if request.auth != null;
      allow write: if isHelmLogicAdmin();
    }

    match /data-warehouse/{vendorId}/masterPriceList/{rowId} {
      allow read: if request.auth != null;
      allow write: if isHelmLogicAdmin();
    }

    match /data-warehouse/{vendorId}/bulkMasterPriceList/{rowId} {
      allow read: if request.auth != null;
      allow write: if isHelmLogicAdmin();
    }

    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if isHelmLogicAdmin();
    }

    match /dealerFitCategories/{categoryId} {
       allow read: if request.auth != null;
       allow write: if isHelmLogicAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
