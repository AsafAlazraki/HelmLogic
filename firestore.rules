
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isHelmLogicAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'HelmLogic Admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == orgId;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isHelmLogicAdmin();
      allow list: if isHelmLogicAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isHelmLogicAdmin();
      allow delete: if isHelmLogicAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /quotes/{quoteId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Organisations ---
    match /organisations/{organisationId} {
      allow get, list: if isSignedIn();
      allow create: if isHelmLogicAdmin();
      allow update: if isHelmLogicAdmin() || isOrgMember(organisationId);
      allow delete: if isHelmLogicAdmin();

      match /exchangeRates/{currencyCode} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
        
        match /changeLog/{logId} {
          allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
        }
      }
      
      match /pricingStrategies/{vendorId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
        
        match /freightContainers/{containerId} {
          allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
        }
      }

      match /dealerFitSelections/{selectionId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
      
      match /modelOverrides/{modelId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
      
      match /priceLevelDefinitions/{levelId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
      
      match /productPrices/{priceId} {
        allow read, write: if isOrgMember(organisationId) || isHelmLogicAdmin();
      }
    }

    // --- Data Warehouse ---
    match /data-warehouse/{vendorId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isHelmLogicAdmin();

      match /masterDataSet/{rowId} {
        allow get, list: if isSignedIn();
        allow write: if isHelmLogicAdmin();
      }

      match /ranges/{rangeId} {
        allow get, list: if isSignedIn();
        allow write: if isHelmLogicAdmin();

        match /models/{modelId} {
          allow get, list: if isSignedIn();
          allow write: if isHelmLogicAdmin();

          match /variants/{variantId} {
            allow get, list: if isSignedIn();
            allow write: if isHelmLogicAdmin();
          }
        }
      }

      match /dataSets/{dataSetId} {
        allow get, list: if isSignedIn();
        allow write: if isHelmLogicAdmin();

        match /rows/{rowId} {
          allow get, list: if isSignedIn();
          allow write: if isHelmLogicAdmin();
        }
      }
    }

    // --- Modules ---
    match /modules/{moduleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isHelmLogicAdmin();
    }

    // --- Dealer Fit Categories ---
    match /dealerFitCategories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isHelmLogicAdmin();
    }

    // --- Global Entities ---
    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }
    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }
    match /vesselReservations/{resId} {
      allow read, write: if isSignedIn();
    }
    match /brands/{brandId} {
      allow read: if isSignedIn();
      allow write: if isHelmLogicAdmin();
    }
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isHelmLogicAdmin();
    }
  }
}
