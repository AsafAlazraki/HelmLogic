rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HelmLogic Security Rules - Prototyping Phase
     * 
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model for personal data and a collaborative 
     * membership model for shared client records. Security is primarily path-based or driven 
     * by denormalized authorization fields within documents.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Robust Admin Check
     * Checks both the dedicated roles_admin collection and the UserProfile.appRole field.
     */
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'HelmLogic Admin')
      );
    }

    /**
     * Organisation Member Check
     * Returns true if the signed-in user belongs to the given organisation.
     * Used to allow org-level admins (e.g. Managing Director) to manage their own org.
     */
    function isOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == orgId;
    }

    /**
     * Parent Organisation Member Check
     * Returns true if the target org is a sub-dealer of the caller's organisation.
     * Allows parent org users to manage their sub-dealer organisations.
     */
    function isParentOrgMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organisations/$(orgId)) &&
        get(/databases/$(database)/documents/organisations/$(orgId)).data.parentOrganisationId != null &&
        get(/databases/$(database)/documents/organisations/$(orgId)).data.parentOrganisationId ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId;
    }

    // --- COLLECTION RULES ---

    // HelmLogic Admins get full access to the entire database
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
        // Same-org members can read each other's profiles
        (isSignedIn() &&
         resource.data.organisationId != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == resource.data.organisationId) ||
        // Parent org members can read sub-dealer user profiles
        (isSignedIn() &&
         resource.data.organisationId != null &&
         exists(/databases/$(database)/documents/organisations/$(resource.data.organisationId)) &&
         get(/databases/$(database)/documents/organisations/$(resource.data.organisationId)).data.parentOrganisationId ==
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId);
      // Allow any signed-in user to create a new user profile (needed for org-level enrollment flow).
      allow create: if isSignedIn();
      // Allow update by the owner, a HelmLogic Admin, or any member of the same organisation
      // (so Managing Directors can edit team member profiles and roles).
      allow update: if isOwner(userId) || isAdmin() ||
        (isSignedIn() &&
         resource.data.organisationId != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == resource.data.organisationId) ||
        // Parent org members can update sub-dealer user profiles
        (isSignedIn() &&
         resource.data.organisationId != null &&
         exists(/databases/$(database)/documents/organisations/$(resource.data.organisationId)) &&
         get(/databases/$(database)/documents/organisations/$(resource.data.organisationId)).data.parentOrganisationId ==
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId);
      allow delete: if isOwner(userId) || isAdmin();

      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /quotes/{quoteId} {
        allow read, write: if isOwner(userId) || isAdmin();
        match /service_items/{itemId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
      match /routes/{routeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /organisations/{orgId} {
      allow read: if isSignedIn();
      // Allow HelmLogic Admins, org members, or parent org members (managing sub-dealers)
      allow write: if isAdmin() || isOrgMember(orgId) || isParentOrgMember(orgId);

      match /templates/{templateId} {
        allow read, write: if isSignedIn();
      }
      match /modelOverrides/{modelId} {
        allow read, write: if isSignedIn();
      }
      match /exchangeRates/{code} {
        allow read, write: if isSignedIn();
        match /changeLog/{logId} {
          allow read, write: if isSignedIn();
        }
      }
      match /pricingStrategies/{vendorId} {
        allow read, write: if isSignedIn();
      }
      match /dealerFitSelections/{selectionId} {
        allow read, write: if isSignedIn();
      }
      match /priceLists/{priceListId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Recursive permission for prototyping across the data-warehouse hierarchy
    match /data-warehouse/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /dealerFitCategories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    match /delivered-deals/{dealId} {
      allow read, write: if isSignedIn();
    }

    // Legacy support for clients collection
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }

    // Legacy support for global models
    match /vessel_models/{vesselModelId} {
      allow read: if isSignedIn();
    }

    // Org members can read any quote belonging to their organisation (collection group query support)
    match /{path=**}/quotes/{quoteId} {
      allow read: if isSignedIn() &&
        resource.data.organisationId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId == resource.data.organisationId;
    }
  }
}
