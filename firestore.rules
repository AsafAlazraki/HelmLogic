rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Core Data Warehouse & Shared Catalog ---

    match /data-warehouse/{vendorId} {
      allow read: if isSignedIn();
      match /{allPaths=**} {
        allow read: if isSignedIn();
      }
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
    }

    match /organisations/{organisationId} {
      allow read, write: if isSignedIn();
      
      // Explicit recursive wildcard for all sub-data in organisations (templates, price levels, etc)
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    // --- Dashboard & Operational Logic ---

    match /inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /vessels/{vesselId} {
      allow read, write: if isSignedIn();
    }

    match /dealerFitCategories/{id} {
      allow read: if isSignedIn();
    }

    // --- User Data & Notifications ---

    match /users/{userId} {
      // Allow global read for member lists and profile resolution
      allow read: if isSignedIn();
      // Allow creation for enrollment and updates for profile management
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();

      match /notifications/{notificationId} {
        allow get, list, write: if isOwner(userId);
      }
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}